```{r setup}
library(ggplot2)
library(grid)

# Barras de frecuencia
fig_barras <- function(x, y, titulo, ymax, xlab = "Valor") {
  d <- data.frame(x = factor(x, levels = x), y = y)
  ggplot(d, aes(x = x, y = y)) +
    geom_col(fill = "grey40", width = 0.75) +
    scale_y_continuous(limits = c(0, ymax), expand = c(0, 0)) +
    labs(title = titulo, x = xlab, y = "Frecuencia") +
    theme_classic(base_size = 10)
}

# Apila los valores repetidos para el diagrama de puntos
apilar <- function(v) {
  d <- data.frame(v = v)
  d$y <- ave(d$v, d$v, FUN = seq_along)
  d
}

tema_puntos <- function() {
  theme_classic(base_size = 10) +
    theme(axis.line.y = element_blank(),
          axis.ticks.y = element_blank(),
          axis.text.y = element_blank(),
          strip.background = element_blank())
}

# Diagrama de puntos de un conjunto
fig_puntos <- function(v, titulo, xlab = "Valor", linea = NULL,
                       etiqueta_linea = NULL, xlim = NULL) {
  d <- apilar(v)
  ymax <- max(2, max(d$y) + 0.8)
  p <- ggplot(d, aes(x = v, y = y)) +
    geom_point(size = 3, colour = "grey25") +
    scale_y_continuous(limits = c(0.3, ymax)) +
    labs(title = titulo, x = xlab, y = NULL) +
    tema_puntos()
  if (!is.null(linea)) {
    p <- p + geom_vline(xintercept = linea, linetype = "dashed", colour = "grey20")
    if (!is.null(etiqueta_linea)) {
      p <- p + annotate("text", x = linea, y = ymax, label = etiqueta_linea,
                        size = 3, vjust = 1, hjust = 1.05)
    }
  }
  if (!is.null(xlim)) p <- p + coord_cartesian(xlim = xlim)
  p
}

# Diagrama de puntos de dos conjuntos
fig_puntos2 <- function(a, b, titulo, xlab = "Valor",
                        etiquetas = c("Conjunto A", "Conjunto B")) {
  da <- apilar(a); da$g <- etiquetas[1]
  db <- apilar(b); db$g <- etiquetas[2]
  d <- rbind(da, db)
  d$g <- factor(d$g, levels = etiquetas)
  ggplot(d, aes(x = v, y = y)) +
    geom_point(size = 3, colour = "grey25") +
    facet_wrap(~ g, ncol = 1) +
    scale_x_continuous(breaks = sort(unique(d$v))) +
    scale_y_continuous(limits = c(0.3, max(3, max(d$y) + 0.6))) +
    labs(title = titulo, x = xlab, y = NULL) +
    tema_puntos() +
    theme(panel.border = element_rect(fill = NA, colour = "grey70"),
          panel.spacing = unit(0.6, "lines"),
          axis.line.x = element_blank())
}

# Diagrama de caja con las observaciones
fig_caja <- function(v, titulo, xlab = "Valor") {
  d <- data.frame(v = v)
  ggplot(d, aes(x = 1, y = v)) +
    geom_boxplot(width = 0.45, fill = "grey90", colour = "grey25",
                 outlier.shape = NA) +
    geom_point(aes(x = 1.5), size = 2.5, colour = "grey25") +
    scale_x_continuous(limits = c(0.6, 1.75)) +
    scale_y_continuous(breaks = seq(min(v), max(v), by = 1)) +
    coord_flip() +
    labs(title = titulo, x = NULL, y = xlab) +
    theme_classic(base_size = 10) +
    theme(axis.line.y = element_blank(),
          axis.ticks.y = element_blank(),
          axis.text.y = element_blank())
}

# Tres distribuciones en una sola fila
fig_tres <- function() {
  d <- rbind(
    data.frame(fig = "Figura 4", x = 1:7, y = c(2, 5, 9, 11, 9, 5, 2)),
    data.frame(fig = "Figura 5", x = 1:7, y = c(11, 9, 7, 5, 3, 2, 1)),
    data.frame(fig = "Figura 6", x = 1:7, y = c(8, 7, 8, 8, 7, 8, 7)))
  ggplot(d, aes(x = factor(x), y = y)) +
    geom_col(fill = "grey40", width = 0.75) +
    facet_wrap(~ fig, nrow = 1) +
    scale_y_continuous(limits = c(0, 12), expand = c(0, 0)) +
    labs(x = "Valor", y = "Frecuencia") +
    theme_classic(base_size = 10) +
    theme(strip.background = element_blank())
}

# Observaciones de una muestra con el intervalo de confianza del promedio
fig_ic <- function(titulo, xlab = "Largo de la hoja (cm)") {
  v <- c(2.0, 2.5, 2.5, 3.0, 3.0, 3.5, 3.5, 3.5, 4.0, 4.0,
         4.0, 4.0, 4.5, 4.5, 4.5, 4.5, 5.0, 5.0, 5.0, 5.0,
         5.0, 5.5, 5.5, 5.5, 5.5, 6.0, 6.0, 6.0, 6.0, 6.5,
         6.5, 6.5, 7.0, 7.0, 7.5, 7.5, 8.0, 8.0, 8.5, 9.0)
  d <- apilar(v)
  ggplot(d, aes(x = v, y = y)) +
    geom_point(size = 2.4, colour = "grey45") +
    annotate("segment", x = 4.2, xend = 5.8, y = -0.9, yend = -0.9,
             colour = "black") +
    annotate("point", x = c(4.2, 5.0, 5.8), y = -0.9, size = 2.2) +
    annotate("text", x = 5.0, y = -2.1, size = 3,
             label = "intervalo de confianza de 95% del promedio") +
    scale_y_continuous(limits = c(-2.6, max(d$y) + 0.6)) +
    labs(title = titulo, x = xlab, y = NULL) +
    tema_puntos()
}
```

